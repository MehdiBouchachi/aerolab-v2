# Safe defaults. Outputs stay disabled until CONFIG_AEROLAB_WIRING_VERIFIED=y is set deliberately.
CONFIG_AEROLAB_WIRING_VERIFIED=n
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_INT_WDT=y
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# ASSUMPTION, NOT A VERIFIED HARDWARE FACT: 4 MB flash (the common ESP32-WROOM-32 size). The partition
# table needs ~2.6 MB, so the 2 MB IDF default cannot hold it. Confirm against the real module before flashing.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
