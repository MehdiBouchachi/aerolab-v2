# AeroLab edge service configuration (copy to .env or an EnvironmentFile).
# NEVER commit real values. Dev secrets are generated by `make dev-provision`
# into the git-ignored .dev/edge.env - you normally do not edit this by hand.

# --- identity ---------------------------------------------------------------
AEROLAB_SITE_ID=site-pilot-01          # immutable, [a-z0-9-], 3-40 chars
AEROLAB_SITE_NAME=AeroLab-Pilot

# --- network ----------------------------------------------------------------
AEROLAB_HTTP_ADDR=0.0.0.0:8080         # put TLS in front for production
AEROLAB_COOKIE_SECURE=false            # MUST be true when served over HTTPS
AEROLAB_STATIC_DIR=                    # built apps/web (Phase 2); empty = built-in landing page

# --- storage ----------------------------------------------------------------
AEROLAB_DB_PATH=/var/lib/aerolab/aerolab.db
AEROLAB_RETENTION_DAYS=30
AEROLAB_MIN_FREE_MIB=64                # below this, telemetry is NOT acknowledged

# --- MQTT (local Mosquitto, per-service account) ------------------------------
AEROLAB_MQTT_URL=tcp://127.0.0.1:1883
AEROLAB_MQTT_USER=aerolab-edge
AEROLAB_MQTT_PASSWORD=                 # supply via /etc/aerolab/secrets, not Git

# --- data honesty -----------------------------------------------------------
# Accept data_source=SIMULATOR. MUST stay false on a real installation.
AEROLAB_ALLOW_SIMULATED_DATA=false

# --- policy (spec defaults) ---------------------------------------------------
AEROLAB_STALE_AFTER=15s
AEROLAB_COMMAND_RETRY=5s
AEROLAB_COMMAND_MAX_TRIES=3            # 1..3
AEROLAB_COMMAND_TTL=120s
AEROLAB_MEM_SOFT_LIMIT_MIB=192         # Go soft memory limit (cgroup MemoryMax is 256M)
AEROLAB_RECORD_QUEUE=2048

# --- cloud (Phase 4; off by default, the Pi works fully without it) -------------
AEROLAB_CLOUD_SYNC_ENABLED=false

# --- first-run only: remove after the admin exists ----------------------------
AEROLAB_BOOTSTRAP_ADMIN_USER=
AEROLAB_BOOTSTRAP_ADMIN_PASSWORD=      # >= 12 chars; or use `edge create-user`

# --- DEV ONLY (SIMULATOR) -----------------------------------------------------
AEROLAB_PROVISION_FILE=                # .dev/devices.json from aerolab-seed

AEROLAB_LOG_LEVEL=info
